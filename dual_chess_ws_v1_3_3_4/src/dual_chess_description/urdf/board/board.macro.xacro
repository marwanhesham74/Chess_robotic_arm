    </link>
    <joint name="board_square_e1_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_e1"/>
      <origin xyz="${0.5*board_square} ${-3.5*board_square} 0" rpy="0 0 0"/>
