<?xml version="1.0"?>
<!-- v1.3.2: supplied full-scale 40cm CAD chessboard.
     Do NOT substitute the former flat 40cm placeholder for this mesh.
     The mesh has Y as its up-axis, starts at one outer corner (0,0,0)
     and uses mm. Its playing squares are 43.75mm (not 50mm):
     the outside frame is 400mm, while the playing area is 350mm wide.
     Rotation +90deg about X -> CAD +Y becomes ROS +Z; CAD +Z -> ROS -Y.
     Board center, fixed robot origins, and a1/h8 frame conventions preserved.
     Collision is a conservative box+frame approximation because input STL
     is not watertight and should not be the dynamic collision mesh.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find dual_chess_description)/urdf/board/board_params_cad.xacro"/>

  <xacro:macro name="chess_board" params="parent">
    <link name="board_link">
      <visual name="board_cad_visual">
        <origin xyz="${-board_size/2} ${board_size/2} ${-board_thickness/2}"
                rpy="${pi/2} 0 0"/>
        <geometry>
          <mesh filename="package://dual_chess_description/meshes/chess_board/Board_1_original.STL"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <!-- STL has no per-square material colours. Preserve its geometry. -->
        <material name="board_wood"/>
      </visual>

      <!-- Board squares are separate fixed child links below. RViz may apply the
           first material to all visuals if they share a single URDF link. -->
      <!-- Collision uses a simplified foundation (z=0..10 mm). -->
      <collision name="playing_area_collision">
        <origin xyz="0 0 ${-board_thickness/2 + board_play_surface_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_size} ${board_size} ${board_play_surface_height}"/></geometry>
      </collision>
      <!-- Four raised perimeter rails, preserving the 35cm playing area. -->
      <collision name="rim_left_collision">
        <origin xyz="${-board_size/2 + board_rim_width/2} 0 ${board_play_surface_height/2}"/>
        <geometry><box size="${board_rim_width} ${board_size} ${board_thickness - board_play_surface_height}"/></geometry>
      </collision>
      <collision name="rim_right_collision">
        <origin xyz="${board_size/2 - board_rim_width/2} 0 ${board_play_surface_height/2}"/>
        <geometry><box size="${board_rim_width} ${board_size} ${board_thickness - board_play_surface_height}"/></geometry>
      </collision>
      <collision name="rim_front_collision">
        <origin xyz="0 ${-board_size/2 + board_rim_width/2} ${board_play_surface_height/2}"/>
        <geometry><box size="${board_play_size} ${board_rim_width} ${board_thickness - board_play_surface_height}"/></geometry>
      </collision>
      <collision name="rim_back_collision">
        <origin xyz="0 ${board_size/2 - board_rim_width/2} ${board_play_surface_height/2}"/>
        <geometry><box size="${board_play_size} ${board_rim_width} ${board_thickness - board_play_surface_height}"/></geometry>
      </collision>

      <!-- The CAD material/density is UNKNOWN. This 1kg inertia is provisional.
           As before, board_link must keep an inertial to survive SDF fixed-link
           conversion and keep its attached reference-frame graph connected. -->
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="${(board_size*board_size+board_thickness*board_thickness)/12.0}" ixy="0" ixz="0"
                 iyy="${(board_size*board_size+board_thickness*board_thickness)/12.0}" iyz="0"
                 izz="${(2*board_size*board_size)/12.0}"/>
      </inertial>
    </link>

    <joint name="board_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="board_link"/>
      <!-- Board rests on world z=0; link origin at the board vertical centre. -->
      <origin xyz="0 0 ${board_thickness/2}" rpy="0 0 0"/>
    </joint>

    <!-- Chessboard frame at the ACTUAL playing-square top plane z=10mm;
         raised outer frame reaches z=20.1892mm. -->
    <link name="board_surface"/>
    <joint name="board_surface_joint" type="fixed">
      <parent link="board_link"/>
      <child link="board_surface"/>
      <origin xyz="0 0 ${board_play_surface_height-board_thickness/2}" rpy="0 0 0"/>
    </joint>

    <!-- 64 checkerboard squares. One visual per fixed link: both RViz and Gazebo
         can render the two materials separately. All are DISPLAY-ONLY:
         no extra collisions, no changes to original CAD mesh or square coords.
         Parent frame board_surface = physical 10 mm playing surface. -->
    <xacro:property name="square_visual_size" value="${board_square*0.985}"/>
    <xacro:property name="square_visual_height" value="0.0008"/>
    <xacro:property name="square_visual_above_surface" value="0.0002"/>

    <link name="board_square_a1">
      <visual name="square_a1_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${square_visual_size} ${square_visual_size} ${square_visual_height}"/></geometry>
        <material name="square_dark"/>
      </visual>
    </link>
    <joint name="board_square_a1_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_a1"/>
      <origin xyz="${-3.5*board_square} ${-3.5*board_square} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_b1">
      <visual name="square_b1_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${square_visual_size} ${square_visual_size} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_b1_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_b1"/>
      <origin xyz="${-2.5*board_square} ${-3.5*board_square} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_c1">
      <visual name="square_c1_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${square_visual_size} ${square_visual_size} ${square_visual_height}"/></geometry>
        <material name="square_dark"/>
      </visual>
    </link>
    <joint name="board_square_c1_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_c1"/>
      <origin xyz="${-1.5*board_square} ${-3.5*board_square} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_d1">
      <visual name="square_d1_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${square_visual_size} ${square_visual_size} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_d1_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_d1"/>
      <origin xyz="${-0.5*board_square} ${-3.5*board_square} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_e1">
      <visual name="square_e1_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${square_visual_size} ${square_visual_size} ${square_visual_height}"/></geometry>
        <material name="square_dark"/>
