<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- SIMULATION ONLY: velocity-bound gz position commands, not hardware-rated limits.
       Replace this stand-in controller when integrating physical motors / ros2_control. -->
  <xacro:property name="cad_sim_velocity_limit" value="0.4"/>

  <!-- v1.3.1 simulated HOME targets in radians (not the mechanical zero reference).
       The two arms are mirrored by their world mounting transforms, so they use
       identical local joint angles and face inwards toward the chessboard.
       Base yaw turns each arm inward; shoulder raises it; elbow bends it.
       These targets are provisional until the mechanical designer approves Home.
       Controllers move from their initial zero states toward HOME on spawn. -->
  <xacro:property name="cad_home_base_yaw" value="${pi/2}"/>
  <xacro:property name="cad_home_shoulder" value="1.15"/>
  <xacro:property name="cad_home_elbow" value="0.35"/>

  <xacro:macro name="cad_hold_joint" params="joint topic home_position">
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>${joint}</joint_name>
        <topic>${topic}</topic>
        <initial_position>${home_position}</initial_position>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>${cad_sim_velocity_limit}</cmd_max>
        <cmd_min>-${cad_sim_velocity_limit}</cmd_min>
      </plugin>
    </gazebo>
  </xacro:macro>
  <!-- Gripper ONLY: separate effort-based PID in simulation.
       Gazebo Harmonic's velocity-commanded position controller can fail to
       reverse a bounded prismatic joint after it reaches its travel stop.
       v1.3.3.4: small integral gain and symmetric windup limits are intended
       to address the measured +1.206mm static position bias on BOTH robots
       in the 0.0/0.01/0.02/0.04m position tests. These are conservative
       simulation tuning candidates, NOT motor / force specifications.
       Leave all four previously verified arm joint controllers untouched.
       A successful ROS2/Gazebo reverse-travel test is REQUIRED on Jazzy. -->
  <xacro:property name="cad_sim_gripper_pid_p" value="10.0"/>
  <xacro:property name="cad_sim_gripper_pid_d" value="0.7"/>
  <xacro:property name="cad_sim_gripper_pid_i" value="3.0"/>
  <xacro:property name="cad_sim_gripper_integral_clamp" value="0.05"/>
  <xacro:property name="cad_sim_gripper_force_limit" value="1.0"/>
  <xacro:macro name="cad_hold_gripper_joint" params="joint topic">
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>${joint}</joint_name>
        <topic>${topic}</topic>
        <initial_position>0.0</initial_position>
        <use_velocity_commands>false</use_velocity_commands>
        <p_gain>${cad_sim_gripper_pid_p}</p_gain>
        <i_gain>${cad_sim_gripper_pid_i}</i_gain>
        <d_gain>${cad_sim_gripper_pid_d}</d_gain>
        <i_max>${cad_sim_gripper_integral_clamp}</i_max>
        <i_min>-${cad_sim_gripper_integral_clamp}</i_min>
        <cmd_max>${cad_sim_gripper_force_limit}</cmd_max>
        <cmd_min>-${cad_sim_gripper_force_limit}</cmd_min>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="cad_chess_arm_gz" params="prefix ns">
    <xacro:cad_hold_joint joint="${prefix}base_yaw_joint" topic="/${ns}/base_yaw_joint/cmd_pos"
                          home_position="${cad_home_base_yaw}"/>
    <xacro:cad_hold_joint joint="${prefix}joint1" topic="/${ns}/joint1/cmd_pos"
                          home_position="${cad_home_shoulder}"/>
    <xacro:cad_hold_joint joint="${prefix}joint2" topic="/${ns}/joint2/cmd_pos"
                          home_position="${cad_home_elbow}"/>
    <xacro:cad_hold_joint joint="${prefix}joint3" topic="/${ns}/joint3/cmd_pos"
                          home_position="0.0"/>
    <xacro:cad_hold_gripper_joint joint="${prefix}gripper_finger_joint"
                                  topic="/${ns}/gripper_finger_joint/cmd_pos"/>
  </xacro:macro>
</robot>
