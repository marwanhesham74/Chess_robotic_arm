<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- CAD visualization model. Gazebo dynamics are not configured yet. -->
  <xacro:macro name="cad_chess_arm" params="prefix parent material *origin">

    <!-- Invisible reference frame for the added base yaw axis -->
    <link name="${prefix}base_yaw_link">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.00001" ixy="0" ixz="0"
                 iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="${prefix}base_yaw_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${prefix}base_yaw_link"/>
      <xacro:insert_block name="origin"/>
      <axis xyz="0 0 1"/>
    </joint>

    <!-- SolidWorks base mesh; translation compensates for its CAD frame -->
    <link name="${prefix}base_link">
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.0003375" ixy="0" ixz="0"
                 iyy="0.0003375" iyz="0" izz="0.00018"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://dual_chess_description/meshes/robot_arm/base_link.STL"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://dual_chess_description/meshes/robot_arm/base_link.STL"/>
        </geometry>
      </collision>
    </link>

    <gazebo reference="${prefix}base_mount_fixed">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <joint name="${prefix}base_mount_fixed" type="fixed">
      <parent link="${prefix}base_yaw_link"/>
      <child link="${prefix}base_link"/>
      <origin xyz="0.185810249819478 0.243972086655367 0.126612878977615"
              rpy="0 0 0"/>
    </joint>

    <link name="${prefix}link0">
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.000125" ixy="0" ixz="0"
                 iyy="6e-05" iyz="0" izz="0.000125"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://dual_chess_description/meshes/robot_arm/link0.STL"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://dual_chess_description/meshes/robot_arm/link0.STL"/>
        </geometry>
      </collision>
    </link>

    <!-- Original SolidWorks fixed transform -->
    <joint name="${prefix}joint0" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link0"/>
      <origin xyz="-0.185810249819478 -0.243972086655367 -0.126612878977615"
              rpy="1.5707963267949 0 0.0189216137804055"/>
    </joint>

    <link name="${prefix}link1">
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.00013" ixy="0" ixz="0"
                 iyy="0.00175" iyz="0" izz="0.00182"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://dual_chess_description/meshes/robot_arm/link1.STL"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://dual_chess_description/meshes/robot_arm/link1.STL"/>
        </geometry>
      </collision>
    </link>

    <!-- Original SolidWorks joint1 -->
    <joint name="${prefix}joint1" type="continuous">
      <parent link="${prefix}link0"/>
      <child link="${prefix}link1"/>
      <origin xyz="0 0.06 0"
              rpy="1.57079632679488 1.39871137927 -1.57079632679491"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${prefix}link2">
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.00013" ixy="0" ixz="0"
                 iyy="0.00175" iyz="0" izz="0.00182"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://dual_chess_description/meshes/robot_arm/link2.STL"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://dual_chess_description/meshes/robot_arm/link2.STL"/>
        </geometry>
      </collision>
    </link>

    <!-- Original SolidWorks joint2 -->
    <joint name="${prefix}joint2" type="continuous">
      <parent link="${prefix}link1"/>
      <child link="${prefix}link2"/>
      <origin xyz="-0.200000000000002 0 0"
              rpy="-3.14159265358979 0 -0.0823720646867807"/>
      <axis xyz="0 0 1"/>
    </joint>

  </xacro:macro>
</robot>
