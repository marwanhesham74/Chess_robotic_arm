<?xml version="1.0"?>
<!-- Solid-primitive inertia helpers: emit only the <inertia> tag.
     PLACEHOLDER MODEL: replace with CAD-derived mass/inertia from M1 (Week 2). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12.0}" iyz="0"
             izz="${m*(x*x+y*y)/12.0}"/>
  </xacro:macro>

  <!-- cylinder axis along local Z -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3.0*r*r+h*h)/12.0}" ixy="0" ixz="0"
             iyy="${m*(3.0*r*r+h*h)/12.0}" iyz="0"
             izz="${m*r*r/2.0}"/>
  </xacro:macro>
</robot>
