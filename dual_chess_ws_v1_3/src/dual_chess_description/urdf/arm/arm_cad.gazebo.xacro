<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- SIMULATION ONLY: velocity-bound gz position commands, not hardware-rated limits.
       Replace this stand-in controller when integrating physical motors / ros2_control. -->
  <xacro:property name="cad_sim_velocity_limit" value="0.4"/>
  <xacro:macro name="cad_hold_joint" params="joint topic">
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>${joint}</joint_name>
        <topic>${topic}</topic>
        <initial_position>0.0</initial_position>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>${cad_sim_velocity_limit}</cmd_max>
        <cmd_min>-${cad_sim_velocity_limit}</cmd_min>
      </plugin>
    </gazebo>
  </xacro:macro>
  <xacro:macro name="cad_chess_arm_gz" params="prefix ns">
    <xacro:cad_hold_joint joint="${prefix}base_yaw_joint" topic="/${ns}/base_yaw_joint/cmd_pos"/>
    <xacro:cad_hold_joint joint="${prefix}joint1" topic="/${ns}/joint1/cmd_pos"/>
    <xacro:cad_hold_joint joint="${prefix}joint2" topic="/${ns}/joint2/cmd_pos"/>
  </xacro:macro>
</robot>
